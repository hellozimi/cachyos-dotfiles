{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "bash": {
      "rm *": "ask",
      "rmdir *": "ask",
      "mv *": "ask",
      "sudo *": "deny",
      "su *": "deny",
      "dd *": "deny",
      "git push *": "deny",
      "git rebase *": "deny",
      "git add *": "deny",
      "ls": "allow",
      "find": "allow",
      "mkdir": "allow",
      "touch": "allow",
      "cat": "allow",
      "head": "allow",
      "tail": "allow",
      "less": "allow",
      "more": "allow",
      "wc": "allow",
      "sed": "allow",
      "awk": "allow",
      "cut": "allow",
      "sort": "allow",
      "uniq": "allow",
      "tr": "allow",
      "rev": "allow",
      "xargs": "allow",
      "paste": "allow",
      "join": "allow",
      "jq": "allow",
      "yq": "allow",
      "make": "ask",
      "npm *": "ask",
      "npx *": "ask",
      "yarn *": "deny",
      "pnpm *": "ask",
      "pip *": "ask",
      "python *": "ask",
      "cargo *": "ask",
      "go *": "ask",
      "env": "allow",
      "printenv": "allow",
      "which": "allow",
      "whereis": "allow",
      "uname": "allow",
      "whoami": "allow",
      "id": "allow",
      "df": "allow",
      "du": "allow",
      "ps": "allow",
      "uptime": "allow",
      "curl": "ask",
      "wget": "ask",
      "ping": "allow",
      "tar": "ask",
      "gzip": "allow",
      "gunzip": "allow",
      "zip": "allow",
      "unzip": "allow",
      "diff": "allow",
      "patch": "ask",
      "basename": "allow",
      "dirname": "allow",
      "readlink": "allow",
      "realpath": "allow",
      "mktemp": "allow",
      "timeout": "allow",
      "tee": "allow",
      "seq": "allow",
      "shuf": "allow",
      "git": "allow"
    }
  }
}
